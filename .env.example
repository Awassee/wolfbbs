# Core database
POSTGRES_USER=wolfbbs
POSTGRES_PASSWORD=change-me
POSTGRES_DB=wolfbbs
WOLFBBS_DATABASE_URL=postgres://wolfbbs:change-me@postgres:5432/wolfbbs?sslmode=disable
WOLFBBS_SQLITE_PATH=
WOLFBBS_DB_MAX_CONN=10
WOLFBBS_DB_CONNECT_RETRIES=15
WOLFBBS_DB_CONNECT_DELAY_MS=500

# Published service ports
WOLFBBS_SSH_PORT=2222
WOLFBBS_WEB_PORT=8080
WOLFBBS_IRC_PORT=6667
WOLFBBS_IRC_TLS_PORT=6697
WOLFBBS_MAILIN_PORT=8091

# Basic setup identity/profile
WOLFBBS_SETUP_PROFILE=basic
WOLFBBS_BBS_NAME=WolfBBS
WOLFBBS_HOSTNAME=localhost

# Session and auth security
WOLFBBS_SESSION_SECRET=replace-with-random-hex
WOLFBBS_INBOUND_TOKEN=replace-with-random-hex
WOLFBBS_SECURE_COOKIE=false
WOLFBBS_READ_ONLY=false
WOLFBBS_REQUIRE_VERIFIED_EMAIL=true
WOLFBBS_PASSWORD_HASH=bcrypt
WOLFBBS_PASSWORD_ALGORITHM=
WOLFBBS_PBKDF2_ITERATIONS=210000
WOLFBBS_PBKDF2_SALT_BYTES=16
WOLFBBS_PASSWORD_UPGRADE_ON_LOGIN=true
WOLFBBS_RESET_TTL_MINUTES=30
WOLFBBS_DEV_SHOW_RESET_TOKEN=false
WOLFBBS_PUBLIC_BASE_URL=

# Optional bootstrap users
WOLFBBS_BOOTSTRAP_ADMIN_HANDLE=
WOLFBBS_BOOTSTRAP_ADMIN_PASSWORD=
WOLFBBS_BOOTSTRAP_MODERATOR_HANDLE=
WOLFBBS_BOOTSTRAP_MODERATOR_PASSWORD=
WOLFBBS_BOOTSTRAP_USER_HANDLE=
WOLFBBS_BOOTSTRAP_USER_PASSWORD=

# SSH/TUI runtime and menu
WOLFBBS_CONFIG_FILE=
WOLFBBS_TERM_ENCODING=utf-8
WOLFBBS_MENU_ENABLE=false
WOLFBBS_MENU_FILE=menus/main.hjson
WOLFBBS_ACS_STRICT=false
WOLFBBS_ACS_BOARDS_READ=
WOLFBBS_ACS_BOARDS_POST=
WOLFBBS_ACS_MAIL_READ=
WOLFBBS_ACS_MAIL_SEND=
WOLFBBS_ACS_FILES_READ=

# Discovery / modern on-ramp
WOLFBBS_GUEST_TOUR_ENABLE=false
WOLFBBS_SMART_NEWSCAN_ENABLE=true
WOLFBBS_SMART_NEWSCAN_MAX=12
WOLFBBS_WEB_ONRAMP_ENABLE=false
WOLFBBS_DISCOVER_ENABLE=false
WOLFBBS_QUICK_JUMP_ENABLE=false
WOLFBBS_CLASSIC_SEARCH_ENABLE=false
WOLFBBS_WS_TERMINAL_URL=ws://localhost:6080/ws-login
WOLFBBS_AI_ASSIST_ENABLE=false

# Door framework and connectors
WOLFBBS_TRIVIA_BINARY=wolfbbs-trivia
WOLFBBS_DOORS=
WOLFBBS_DOOR_ALLOW_DIR=
WOLFBBS_DOOR_DATA_ROOT=/app/.wolfbbs/doors
WOLFBBS_DOOR_DROPFILES=
WOLFBBS_ORACLE_DAILY_PROMPTS=10
WOLFBBS_DOORPARTY_ENABLE=false
WOLFBBS_DOORPARTY_COMMAND=
WOLFBBS_DOORPARTY_ARGS=
WOLFBBS_BBSLINK_ENABLE=false
WOLFBBS_BBSLINK_COMMAND=
WOLFBBS_BBSLINK_ARGS=
WOLFBBS_TELNET_BRIDGE_ENABLE=false
WOLFBBS_TELNET_BRIDGE_COMMAND=
WOLFBBS_TELNET_BRIDGE_ARGS=

# Login server transports
WOLFBBS_TELNET_ENABLE=false
WOLFBBS_TELNET_LISTEN=:2323
WOLFBBS_WS_ENABLE=false
WOLFBBS_WS_LISTEN=:6080
WOLFBBS_WS_PATH=/ws-login
WOLFBBS_WSS_ENABLE=false
WOLFBBS_WSS_LISTEN=:6443
WOLFBBS_WSS_PATH=/ws-login
WOLFBBS_WSS_CERT=
WOLFBBS_WSS_KEY=
WOLFBBS_TRUSTED_PROXIES=

# Gateway and offline reader
WOLFBBS_OFFLINE_DIR=/app/.wolfbbs/offline
WOLFBBS_MAILIN_ALLOW_DOMAINS=
WOLFBBS_MAILIN_FORWARD_URL=
WOLFBBS_MAIL_MAX_RECIPIENTS=3
WOLFBBS_MAIL_MAX_BYTES=65536
WOLFBBS_MAIL_RATE_PER_HOUR=20

# SMTP relay (both prefixed and unprefixed are supported)
WOLFBBS_SMTP_HOST=
WOLFBBS_SMTP_PORT=587
WOLFBBS_SMTP_USER=
WOLFBBS_SMTP_PASS=
WOLFBBS_FROM_DOMAIN=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_DOMAIN=

# Unified chat service tuning
WOLFBBS_CHAT_HISTORY_LIMIT=200
WOLFBBS_CHAT_RATE_BURST=8
WOLFBBS_CHAT_RATE_WINDOW_MS=1000
WOLFBBS_CHAT_RETENTION_HOURS=24
WOLFBBS_CHAT_POLL_INTERVAL_MS=500

# IRC service tuning and safety
WOLFBBS_IRC_TLS_LISTEN=
WOLFBBS_IRC_TLS_CERT=
WOLFBBS_IRC_TLS_KEY=
WOLFBBS_IRC_MAX_CONN=512
WOLFBBS_IRC_MAX_CONN_PER_IP=16
WOLFBBS_IRC_MSG_BURST=8
WOLFBBS_IRC_MSG_WINDOW_MS=1500
WOLFBBS_IRC_IP_MSG_BURST=20
WOLFBBS_IRC_IP_MSG_WINDOW_MS=2000
WOLFBBS_IRC_POLL_MS=1200
WOLFBBS_IRC_REQUIRE_PASS=true
WOLFBBS_IRC_ALLOW_ALIAS=false
WOLFBBS_IRC_BANNED_IPS=

# Optional content servers / federation
WOLFBBS_CONTENT_HOST=localhost
WOLFBBS_GOPHER_LISTEN=
WOLFBBS_NNTP_LISTEN=
WOLFBBS_NNTPS_LISTEN=
WOLFBBS_NNTPS_CERT=
WOLFBBS_NNTPS_KEY=
WOLFBBS_ACTIVITYPUB_ENABLE=false
WOLFBBS_ACTIVITYPUB_BASE_URL=
