{
  "id": "telnet-bridge",
  "display_name": "Telnet Bridge",
  "short_description": "Bridge to remote telnet-accessible systems with policy controls.",
  "category": "utility",
  "version": "1.0.0",
  "entry_type": "native",
  "entrypoint": "native:telnet-bridge",
  "hotkey": "R",
  "concurrency_mode": "shared",
  "requires": {
    "ansi": true,
    "min_cols": 80,
    "min_rows": 25
  },
  "capabilities": {
    "needs_network": true,
    "needs_filesystem_write": false,
    "needs_sound": false
  },
  "data_retention": {
    "messages_days": 30,
    "logs_days": 90
  },
  "admin_defaults": {
    "enabled": true,
    "daily_turns": 0,
    "time_bank_max": 0,
    "reset_hour": 0,
    "max_run_seconds": 120,
    "max_output_rate": 4096
  },
  "required_role": "user",
  "help_text": "Telnet Bridge: launch approved remote telnet bridges and return cleanly.",
  "rules_text": "Target bridges must be sysop-approved; all bridge sessions are audited.",
  "args": []
}
