{
  "id": "bulletin-news-center",
  "display_name": "Bulletin + News Center",
  "short_description": "Bulletins, pinned notices, and optional RSS ingest cache.",
  "category": "utility",
  "version": "1.0.0",
  "entry_type": "native",
  "entrypoint": "native:bulletin-news-center",
  "hotkey": "W",
  "concurrency_mode": "shared",
  "requires": {
    "ansi": true,
    "min_cols": 80,
    "min_rows": 25
  },
  "capabilities": {
    "needs_network": true,
    "needs_filesystem_write": false,
    "needs_sound": false
  },
  "data_retention": {
    "messages_days": 30,
    "logs_days": 90
  },
  "admin_defaults": {
    "enabled": true,
    "daily_turns": 0,
    "time_bank_max": 0,
    "reset_hour": 0,
    "max_run_seconds": 120,
    "max_output_rate": 4096
  },
  "required_role": "user",
  "help_text": "Bulletin + News Center: read rotating bulletins and cached news feeds.",
  "rules_text": "External feeds are sanitized and cached before display.",
  "args": []
}
