{
  "id": "door-hub",
  "display_name": "Door Hub",
  "short_description": "Favorites, recent doors, turn totals, and quick launch.",
  "category": "utility",
  "version": "1.0.0",
  "entry_type": "native",
  "entrypoint": "native:door-hub",
  "hotkey": "S",
  "concurrency_mode": "shared",
  "requires": {
    "ansi": true,
    "min_cols": 80,
    "min_rows": 25
  },
  "capabilities": {
    "needs_network": false,
    "needs_filesystem_write": false,
    "needs_sound": false
  },
  "data_retention": {
    "messages_days": 30,
    "logs_days": 90
  },
  "admin_defaults": {
    "enabled": true,
    "daily_turns": 0,
    "time_bank_max": 0,
    "reset_hour": 0,
    "max_run_seconds": 120,
    "max_output_rate": 4096
  },
  "required_role": "user",
  "help_text": "Door Hub: browse categories, favorites, and newly added doors.",
  "rules_text": "Hub actions are read-mostly and immediate.",
  "args": []
}
