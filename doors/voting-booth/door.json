{
  "id": "voting-booth",
  "display_name": "Voting Booth",
  "short_description": "Create and answer polls with ANSI chart output.",
  "category": "utility",
  "version": "1.0.0",
  "entry_type": "native",
  "entrypoint": "native:voting-booth",
  "hotkey": "V",
  "concurrency_mode": "shared",
  "requires": {
    "ansi": true,
    "min_cols": 80,
    "min_rows": 25
  },
  "capabilities": {
    "needs_network": false,
    "needs_filesystem_write": false,
    "needs_sound": false
  },
  "data_retention": {
    "messages_days": 30,
    "logs_days": 90
  },
  "admin_defaults": {
    "enabled": true,
    "daily_turns": 0,
    "time_bank_max": 0,
    "reset_hour": 0,
    "max_run_seconds": 120,
    "max_output_rate": 4096
  },
  "required_role": "user",
  "help_text": "Voting Booth: cast votes and view results charts in text mode.",
  "rules_text": "Poll windows and anonymity settings are enforced by sysop policy.",
  "args": []
}
