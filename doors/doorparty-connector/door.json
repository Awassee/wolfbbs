{
  "id": "doorparty-connector",
  "display_name": "DoorParty Connector",
  "short_description": "Bridge to remote door catalogs via secure tunnel.",
  "category": "utility",
  "version": "1.0.0",
  "entry_type": "native",
  "entrypoint": "native:doorparty-connector",
  "hotkey": "T",
  "concurrency_mode": "shared",
  "requires": {
    "ansi": true,
    "min_cols": 80,
    "min_rows": 25
  },
  "capabilities": {
    "needs_network": true,
    "needs_filesystem_write": false,
    "needs_sound": false
  },
  "data_retention": {
    "messages_days": 30,
    "logs_days": 90
  },
  "admin_defaults": {
    "enabled": true,
    "daily_turns": 0,
    "time_bank_max": 0,
    "reset_hour": 0,
    "max_run_seconds": 120,
    "max_output_rate": 4096
  },
  "required_role": "user",
  "help_text": "DoorParty Connector: launch approved remote sessions and return cleanly.",
  "rules_text": "Remote doors must be explicitly allowed by sysop policy.",
  "args": []
}
