{
  "id": "ansi-art-gallery",
  "display_name": "ANSI Art Gallery + SAUCE",
  "short_description": "Browse art packs and parse SAUCE metadata.",
  "category": "utility",
  "version": "1.0.0",
  "entry_type": "native",
  "entrypoint": "native:ansi-art-gallery",
  "hotkey": "Y",
  "concurrency_mode": "shared",
  "requires": {
    "ansi": true,
    "min_cols": 80,
    "min_rows": 25
  },
  "capabilities": {
    "needs_network": false,
    "needs_filesystem_write": true,
    "needs_sound": false
  },
  "data_retention": {
    "messages_days": 30,
    "logs_days": 90
  },
  "admin_defaults": {
    "enabled": true,
    "daily_turns": 0,
    "time_bank_max": 0,
    "reset_hour": 0,
    "max_run_seconds": 120,
    "max_output_rate": 4096
  },
  "required_role": "user",
  "help_text": "ANSI Art Gallery: browse approved packs and weekly featured art.",
  "rules_text": "Uploads may require admin approval depending on policy settings.",
  "args": []
}
